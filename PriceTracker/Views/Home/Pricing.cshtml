@section Scripts {
    <script>
        // Copy Revolut username to clipboard
        function copyToClipboard(elementId) {
            const element = document.getElementById(elementId);
            const text = element.textContent;

            navigator.clipboard.writeText(text).then(function() {
                // Show success feedback
                const button = element.nextElementSibling;
                const originalText = button.innerHTML;
                button.innerHTML = '<i class="fas fa-check me-1"></i>Copied!';
                button.classList.remove('btn-primary');
                button.classList.add('btn-success');

                setTimeout(() => {
                    button.innerHTML = originalText;
                    button.classList.remove('btn-success');
                    button.classList.add('btn-primary');
                }, 2000);
            }).catch(function(err) {
                console.error('Could not copy text: ', err);
                // Fallback for older browsers
                element.select();
                document.execCommand('copy');
                alert('Username copied to clipboard!');
            });
        }

        // Smooth scroll to features section
        function scrollToFeatures() {
            const featuresSection = document.querySelector('.features-showcase-section');
            if (featuresSection) {
                featuresSection.scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });
            }
        }

        // Smooth scroll to next section
        function scrollToNextSection() {
            const nextSection = document.querySelector('.features-showcase-section');
            if (nextSection) {
                nextSection.scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });
            }
        }

        // Enhanced interactive features
        document.addEventListener('DOMContentLoaded', function() {
            // Add click animation to donation items
            const donationItems = document.querySelectorAll('.donation-item');
            donationItems.forEach(item => {
                item.addEventListener('click', function() {
                    this.style.transform = 'scale(0.95)';
                    setTimeout(() => {
                        this.style.transform = 'scale(1)';
                    }, 150);
                });
            });

            // Add click animation to value proposition items
            const valueItems = document.querySelectorAll('.value-item');
            valueItems.forEach(item => {
                item.addEventListener('click', function() {
                    // Create ripple effect
                    const ripple = document.createElement('div');
                    ripple.style.position = 'absolute';
                    ripple.style.borderRadius = '50%';
                    ripple.style.background = 'rgba(255, 255, 255, 0.6)';
                    ripple.style.width = '20px';
                    ripple.style.height = '20px';
                    ripple.style.left = '50%';
                    ripple.style.top = '50%';
                    ripple.style.transform = 'translate(-50%, -50%)';
                    ripple.style.animation = 'ripple 0.6s ease-out';
                    ripple.style.pointerEvents = 'none';

                    this.style.position = 'relative';
                    this.appendChild(ripple);

                    setTimeout(() => {
                        if (ripple.parentNode) {
                            ripple.parentNode.removeChild(ripple);
                        }
                    }, 600);
                });
            });

            // Add hover effects to floating elements
            const floatingElements = document.querySelectorAll('.float-element');
            floatingElements.forEach(element => {
                element.addEventListener('mouseenter', function() {
                    this.style.animation = 'none';
                    this.style.transform = 'scale(1.5)';
                    this.style.opacity = '0.8';
                });

                element.addEventListener('mouseleave', function() {
                    this.style.animation = '';
                    this.style.transform = '';
                    this.style.opacity = '';
                });
            });

            // Add parallax effect to floating elements on scroll
            window.addEventListener('scroll', function() {
                const scrolled = window.pageYOffset;
                const parallax = scrolled * 0.5;

                floatingElements.forEach((element, index) => {
                    const speed = (index + 1) * 0.1;
                    element.style.transform = `translateY(${parallax * speed}px)`;
                });
            });

            // Add intersection observer for animations
            const observerOptions = {
                threshold: 0.1,
                rootMargin: '0px 0px -50px 0px'
            };

            const observer = new IntersectionObserver(function(entries) {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('animate-in');
                    }
                });
            }, observerOptions);

            // Observe elements for animation
            const animateElements = document.querySelectorAll('.feature-category-card, .support-card, .accordion-item, .features-cta');
            animateElements.forEach(el => observer.observe(el));

            // Add feature card interactions
            const featureCards = document.querySelectorAll('.feature-category-card');
            featureCards.forEach(card => {
                card.addEventListener('click', function() {
                    // Add ripple effect
                    const ripple = document.createElement('div');
                    ripple.style.position = 'absolute';
                    ripple.style.borderRadius = '50%';
                    ripple.style.background = 'rgba(79, 70, 229, 0.3)';
                    ripple.style.width = '20px';
                    ripple.style.height = '20px';
                    ripple.style.left = '50%';
                    ripple.style.top = '50%';
                    ripple.style.transform = 'translate(-50%, -50%)';
                    ripple.style.animation = 'ripple 0.6s ease-out';
                    ripple.style.pointerEvents = 'none';
                    ripple.style.zIndex = '10';

                    this.style.position = 'relative';
                    this.appendChild(ripple);

                    setTimeout(() => {
                        if (ripple.parentNode) {
                            ripple.parentNode.removeChild(ripple);
                        }
                    }, 600);
                });

                // Add hover sound effect (optional)
                card.addEventListener('mouseenter', function() {
                    const icon = this.querySelector('.feature-main-icon');
                    if (icon) {
                        icon.style.animation = 'none';
                        icon.offsetHeight; // Trigger reflow
                        icon.style.animation = 'bounce 0.6s ease-in-out';
                    }
                });
            });

            // Add feature item interactions
            const featureItems = document.querySelectorAll('.feature-item');
            featureItems.forEach(item => {
                item.addEventListener('click', function() {
                    const icon = this.querySelector('.feature-item-icon');
                    if (icon) {
                        icon.style.transform = 'scale(1.3) rotate(360deg)';
                        setTimeout(() => {
                            icon.style.transform = '';
                        }, 500);
                    }
                });
            });

            // Add scroll-triggered animations for feature cards
            const featureCardsObserver = new IntersectionObserver(function(entries) {
                entries.forEach((entry, index) => {
                    if (entry.isIntersecting) {
                        setTimeout(() => {
                            entry.target.classList.add('animate-in');
                        }, index * 100); // Staggered animation
                    }
                });
            }, {
                threshold: 0.2,
                rootMargin: '0px 0px -100px 0px'
            });

            featureCards.forEach(card => {
                featureCardsObserver.observe(card);
            });

            // Add parallax effect to section backgrounds
            window.addEventListener('scroll', function() {
                const scrolled = window.pageYOffset;
                const parallax = scrolled * 0.3;

                const featuresSection = document.querySelector('.features-showcase-section');
                if (featuresSection) {
                    featuresSection.style.backgroundPosition = `center ${parallax}px`;
                }
            });

            // Add dynamic icon animations on card hover
            featureCards.forEach(card => {
                const icon = card.querySelector('.feature-main-icon');
                const background = card.querySelector('.icon-background');

                card.addEventListener('mouseenter', function() {
                    if (icon && background) {
                        icon.style.animation = 'iconDance 0.8s ease-in-out';
                        background.style.animation = 'backgroundPulse 0.8s ease-in-out';
                    }
                });

                card.addEventListener('mouseleave', function() {
                    if (icon && background) {
                        icon.style.animation = '';
                        background.style.animation = '';
                    }
                });
            });

            // Add dynamic text effect to headline
            const headlineHighlight = document.querySelector('.headline-highlight');
            if (headlineHighlight) {
                const text = headlineHighlight.textContent;
                const colors = ['#f59e0b', '#10b981', '#06b6d4', '#8b5cf6', '#ef4444'];
                let colorIndex = 0;

                setInterval(() => {
                    headlineHighlight.style.background = `linear-gradient(45deg, ${colors[colorIndex]}, ${colors[(colorIndex + 1) % colors.length]}, ${colors[(colorIndex + 2) % colors.length]})`;
                    headlineHighlight.style.backgroundSize = '300% 300%';
                    headlineHighlight.style.webkitBackgroundClip = 'text';
                    headlineHighlight.style.backgroundClip = 'text';
                    colorIndex = (colorIndex + 1) % colors.length;
                }, 3000);
            }

            // Add loading animation to hero buttons
            const heroButtons = document.querySelectorAll('.btn-hero-primary, .btn-hero-secondary');
            heroButtons.forEach(button => {
                button.addEventListener('click', function(e) {
                    if (this.classList.contains('btn-hero-secondary')) {
                        e.preventDefault();
                        scrollToFeatures();
                        return;
                    }

                    // Add loading state for primary button
                    const originalText = this.innerHTML;
                    this.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Getting Started...';
                    this.disabled = true;

                    // Simulate loading (remove this in production)
                    setTimeout(() => {
                        this.innerHTML = originalText;
                        this.disabled = false;
                    }, 2000);
                });
            });
        });

     
    </script>
}