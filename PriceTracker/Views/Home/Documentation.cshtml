@{
    ViewData["Title"] = "Documentation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/landingPage/documentation.css" />
}

<div class="documentation-container">
    <!-- Left Sidebar Navigation -->
    <nav class="documentation-sidebar" id="documentationSidebar">
        <div class="sidebar-header">
            <h4 class="sidebar-title">Documentation</h4>
            <button class="sidebar-toggle d-md-none" id="sidebarToggle" aria-label="Toggle sidebar">
                <i class="fas fa-bars"></i>
            </button>
        </div>

        <div class="sidebar-search">
            <div class="search-container">
                <input type="text" id="documentationSearch" class="form-control search-input"
                       placeholder="Search documentation..." aria-label="Search documentation">
                <i class="fas fa-search search-icon"></i>
            </div>
        </div>

        <div class="sidebar-menu" id="sidebarMenu">
            <!-- Getting Started Section -->
            <div class="menu-section">
                <button class="menu-section-header" data-bs-toggle="collapse" data-bs-target="#gettingStartedMenu"
                        aria-expanded="true" aria-controls="gettingStartedMenu">
                    <i class="fas fa-rocket"></i>
                    <span>Getting Started</span>
                    <i class="fas fa-chevron-down collapse-icon"></i>
                </button>
                <div class="collapse show" id="gettingStartedMenu">
                    <div class="menu-items">
                        <a href="#overview" class="menu-item active" data-section="overview">
                            <i class="fas fa-home"></i> Overview
                        </a>
                        <a href="#installation" class="menu-item" data-section="installation">
                            <i class="fas fa-download"></i> Installation
                        </a>
                        <a href="#first-steps" class="menu-item" data-section="first-steps">
                            <i class="fas fa-play"></i> First Steps
                        </a>
                    </div>
                </div>
            </div>

            <!-- Features Section -->
            <div class="menu-section">
                <button class="menu-section-header" data-bs-toggle="collapse" data-bs-target="#featuresMenu"
                        aria-expanded="false" aria-controls="featuresMenu">
                    <i class="fas fa-star"></i>
                    <span>Features</span>
                    <i class="fas fa-chevron-down collapse-icon"></i>
                </button>
                <div class="collapse" id="featuresMenu">
                    <div class="menu-items">
                        <a href="#price-tracking" class="menu-item" data-section="price-tracking">
                            <i class="fas fa-chart-line"></i> Price Tracking
                        </a>
                        <a href="#budget-management" class="menu-item" data-section="budget-management">
                            <i class="fas fa-wallet"></i> Budget Management
                        </a>
                        <a href="#task-management" class="menu-item" data-section="task-management">
                            <i class="fas fa-tasks"></i> Task Management
                        </a>
                        <a href="#notifications" class="menu-item" data-section="notifications">
                            <i class="fas fa-bell"></i> Notifications
                        </a>
                    </div>
                </div>
            </div>

            <!-- User Guide Section -->
            <div class="menu-section">
                <button class="menu-section-header" data-bs-toggle="collapse" data-bs-target="#userGuideMenu"
                        aria-expanded="false" aria-controls="userGuideMenu">
                    <i class="fas fa-book"></i>
                    <span>User Guide</span>
                    <i class="fas fa-chevron-down collapse-icon"></i>
                </button>
                <div class="collapse" id="userGuideMenu">
                    <div class="menu-items">
                        <a href="#adding-products" class="menu-item" data-section="adding-products">
                            <i class="fas fa-plus"></i> Adding Products
                        </a>
                        <a href="#setting-budgets" class="menu-item" data-section="setting-budgets">
                            <i class="fas fa-piggy-bank"></i> Setting Budgets
                        </a>
                        <a href="#tracking-expenses" class="menu-item" data-section="tracking-expenses">
                            <i class="fas fa-receipt"></i> Tracking Expenses
                        </a>
                        <a href="#managing-tasks" class="menu-item" data-section="managing-tasks">
                            <i class="fas fa-check-circle"></i> Managing Tasks
                        </a>
                    </div>
                </div>
            </div>

            <!-- Support Section -->
            <div class="menu-section">
                <button class="menu-section-header" data-bs-toggle="collapse" data-bs-target="#supportMenu"
                        aria-expanded="false" aria-controls="supportMenu">
                    <i class="fas fa-life-ring"></i>
                    <span>Support</span>
                    <i class="fas fa-chevron-down collapse-icon"></i>
                </button>
                <div class="collapse" id="supportMenu">
                    <div class="menu-items">
                        <a href="#faq" class="menu-item" data-section="faq">
                            <i class="fas fa-question-circle"></i> FAQ
                        </a>
                        <a href="#troubleshooting" class="menu-item" data-section="troubleshooting">
                            <i class="fas fa-wrench"></i> Troubleshooting
                        </a>
                        <a href="#contact" class="menu-item" data-section="contact">
                            <i class="fas fa-envelope"></i> Contact Support
                        </a>
                    </div>
                </div>
            </div>

            <!-- Legal Section -->
            <div class="menu-section">
                <button class="menu-section-header" data-bs-toggle="collapse" data-bs-target="#legalMenu"
                        aria-expanded="false" aria-controls="legalMenu">
                    <i class="fas fa-gavel"></i>
                    <span>Legal</span>
                    <i class="fas fa-chevron-down collapse-icon"></i>
                </button>
                <div class="collapse" id="legalMenu">
                    <div class="menu-items">
                        <a href="#privacy-policy" class="menu-item" data-section="privacy-policy">
                            <i class="fas fa-shield-alt"></i> Privacy Policy
                        </a>
                        <a href="#terms-of-service" class="menu-item" data-section="terms-of-service">
                            <i class="fas fa-file-contract"></i> Terms of Service
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main class="documentation-content" id="documentationContent">
        <!-- Breadcrumb Navigation -->
        <nav aria-label="Documentation breadcrumb" class="documentation-breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Documentation</li>
                <li class="breadcrumb-item active" id="currentSection" aria-current="page">Overview</li>
            </ol>
        </nav>

        <!-- Content Sections -->
        <div class="content-section active" id="overview-content">
            <div class="section-header">
                <h1 class="section-title">Welcome to PriceTracker Documentation</h1>
                <p class="section-subtitle">Everything you need to know about managing prices, budgets, and tasks efficiently</p>
            </div>

            <div class="section-body">
                <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
                    <i class="fas fa-info-circle me-3"></i>
                    <div>
                        <strong>New to PriceTracker?</strong> Start with our <a href="#first-steps" class="alert-link">First Steps guide</a>
                        to get up and running quickly.
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="feature-card">
                            <div class="feature-icon">
                                <i class="fas fa-chart-line"></i>
                            </div>
                            <h3>Price Tracking</h3>
                            <p>Monitor product prices across multiple stores, view price history, and get recommendations for the best deals.</p>
                            <a href="#price-tracking" class="btn btn-outline-primary btn-sm">Learn More</a>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="feature-card">
                            <div class="feature-icon">
                                <i class="fas fa-wallet"></i>
                            </div>
                            <h3>Budget Management</h3>
                            <p>Set monthly budgets, track expenses, and receive alerts when you're approaching spending limits.</p>
                            <a href="#budget-management" class="btn btn-outline-primary btn-sm">Learn More</a>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="feature-card">
                            <div class="feature-icon">
                                <i class="fas fa-tasks"></i>
                            </div>
                            <h3>Task Management</h3>
                            <p>Organize your shopping lists, set priorities, and never forget important tasks with our notification system.</p>
                            <a href="#task-management" class="btn btn-outline-primary btn-sm">Learn More</a>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="feature-card">
                            <div class="feature-icon">
                                <i class="fas fa-chart-bar"></i>
                            </div>
                            <h3>Reports & Analytics</h3>
                            <p>Gain insights into your spending patterns with detailed reports and interactive charts.</p>
                            <a href="#reports" class="btn btn-outline-primary btn-sm">Learn More</a>
                        </div>
                    </div>
                </div>

                <div class="quick-links mt-5">
                    <h3>Quick Links</h3>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <a href="#installation" class="quick-link-card">
                                <i class="fas fa-download"></i>
                                <span>Installation Guide</span>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a href="#faq" class="quick-link-card">
                                <i class="fas fa-question-circle"></i>
                                <span>Frequently Asked Questions</span>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a href="#contact" class="quick-link-card">
                                <i class="fas fa-envelope"></i>
                                <span>Get Support</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Placeholder sections for other content (to be populated) -->
        <div class="content-section" id="installation-content" style="display: none;">
            <h1>Installation Guide</h1>
            <p>Installation content will be added here...</p>
        </div>

        <div class="content-section" id="first-steps-content" style="display: none;">
            <h1>First Steps</h1>
            <p>First steps content will be added here...</p>
        </div>

        <!-- Additional content sections will be added here -->

    </main>

    <!-- Right Sidebar - Table of Contents -->
    <aside class="documentation-toc d-none d-xl-block" id="documentationToc">
        <div class="toc-header">
            <h5>On This Page</h5>
        </div>
        <nav class="toc-nav" id="tocNav">
            <ul class="toc-list">
                <li><a href="#overview" class="toc-link active">Overview</a></li>
                <li><a href="#features" class="toc-link">Features</a></li>
                <li><a href="#quick-links" class="toc-link">Quick Links</a></li>
            </ul>
        </nav>
    </aside>
</div>

<!-- Back to Top Button -->
<button class="back-to-top" id="backToTop" aria-label="Back to top">
    <i class="fas fa-arrow-up"></i>
</button>

@section Scripts {
    <script src="~/js/landingPage/documentation.js"></script>
}