@{
    // Check if we're on an Account/Manage page
    var isAccountManagePage = ViewContext.RouteData.Values["Area"]?.ToString() == "Identity" &&
                             ViewContext.RouteData.Values["Page"]?.ToString()?.Contains("/Account/Manage") == true;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PriceTracker</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/breadcrumb.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/navigation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/notification-badges.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/mobile-navigation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PriceTracker.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        // Load navigation helper data
        await Component.InvokeAsync("Navigation");
        var navModel = ViewData["NavigationModel"] as dynamic;
    }

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" href="@(User.Identity!.IsAuthenticated ? Url.Action("Index", "Dashboard") : Url.Action("Index", "Land"))">
                    <i class="fas fa-chart-line me-2"></i>PriceTracker
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    @if (User.Identity.IsAuthenticated && navModel != null)
                    {
                        <!-- Authenticated User Navigation with Dropdowns -->
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="@navModel.GetNavLinkCss("dashboard")" asp-controller="Dashboard" asp-action="Index">
                                    <i class="fas fa-tachometer-alt me-1"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="@navModel.GetNavLinkCss("price-tracking") nav-link dropdown-toggle" href="#" id="priceTrackingDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-chart-line me-1"></i>Price Tracking
                                    <span class="badge bg-success ms-1" id="navPriceBadge" style="display: none;">2</span>
                                </a>
                                <ul class="dropdown-menu @(navModel.GetDropdownCss("price-tracking") ?? "")">
                                    <li>
                                        <a class="@navModel.GetDropdownItemCss("price-tracking", "add-product")" href="#">
                                            <i class="fas fa-plus me-2"></i>Add Product
                                        </a>
                                    </li>
                                    <li>
                                        <a class="@navModel.GetDropdownItemCss("price-tracking", "my-products")" href="#">
                                            <i class="fas fa-boxes me-2"></i>My Products
                                        </a>
                                    </li>
                                    <li>
                                        <a class="@navModel.GetDropdownItemCss("price-tracking", "stores")" href="#">
                                            <i class="fas fa-store me-2"></i>Stores
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="@navModel.GetDropdownItemCss("price-tracking", "analytics")" href="#">
                                            <i class="fas fa-chart-bar me-2"></i>Price Analytics
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="@navModel.GetNavLinkCss("budget") nav-link dropdown-toggle" href="#" id="budgetDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-wallet me-1"></i>Budget
                                    <span class="badge bg-warning ms-1" id="navBudgetBadge" style="display: none;">!</span>
                                </a>
                                <ul class="dropdown-menu @(navModel.GetDropdownCss("budget") ?? "")">
                                    <li>
                                        <a class="@navModel.GetDropdownItemCss("budget", "add-expense")" href="#">
                                            <i class="fas fa-plus me-2"></i>Add Expense
                                        </a>
                                    </li>
                                    <li>
                                        <a class="@navModel.GetDropdownItemCss("budget", "monthly-budget")" href="#">
                                            <i class="fas fa-calendar-alt me-2"></i>Monthly Budget
                                        </a>
                                    </li>
                                    <li>
                                        <a class="@navModel.GetDropdownItemCss("budget", "expenses")" href="#">
                                            <i class="fas fa-receipt me-2"></i>Expenses
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="@navModel.GetDropdownItemCss("budget", "reports")" href="#">
                                            <i class="fas fa-chart-pie me-2"></i>Budget Reports
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="@navModel.GetNavLinkCss("tasks") nav-link dropdown-toggle" href="#" id="tasksDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="@(navModel.GetDropdownOpenClass("tasks") == "show" ? "true" : "false")">
                                    <i class="fas fa-tasks me-1"></i>Tasks
                                    <span class="badge bg-danger ms-1" id="navTaskBadge" style="display: none;">3</span>
                                </a>
                                <ul class="dropdown-menu @(navModel.GetDropdownCss("tasks") ?? navModel.GetDropdownOpenClass("tasks") == "show" ? "show" : "")">
                                    <li>
                                        <a class="@navModel.GetDropdownItemCss("tasks", "create-task")" href="#">
                                            <i class="fas fa-plus me-2"></i>Create Task
                                        </a>
                                    </li>
                                    <li>
                                        <a class="@navModel.GetDropdownItemCss("tasks", "my-tasks")" href="#">
                                            <i class="fas fa-list-check me-2"></i>My Tasks
                                        </a>
                                    </li>
                                    <li>
                                        <a class="@navModel.GetDropdownItemCss("tasks", "notifications")" href="#">
                                            <i class="fas fa-bell me-2"></i>Notifications
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="@navModel.GetDropdownItemCss("tasks", "task-analytics")" href="#">
                                            <i class="fas fa-chart-gantt me-2"></i>Task Analytics
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                    else if (!User.Identity.IsAuthenticated)
                    {
                        <!-- Navigation for Anonymous Users -->
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Land" ? "active" : "")"
                                   asp-controller="Land" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="#features">Features</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="#pricing">Pricing</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="#about">About</a>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <!-- Fallback navigation if navigation model fails to load -->
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Dashboard" asp-action="Index">
                                    <i class="fas fa-tachometer-alt me-1"></i>Dashboard
                                </a>
                            </li>
                        </ul>
                    }

                    <!-- User Authentication Partial -->
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <!-- Breadcrumb Navigation for Authenticated Users -->
        @if (User.Identity.IsAuthenticated)
        {
            @await Component.InvokeAsync("Breadcrumb")
        }

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @if (!isAccountManagePage)
    {
        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2024 - PriceTracker -
                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                }
                else
                {
                    <a asp-controller="Land" asp-action="Index">Home</a>
                }
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/pagesAuthUsers/shared/notification-badges.js" asp-append-version="true"></script>
    <script src="~/js/pagesAuthUsers/shared/mobile-navigation.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    @if (User.Identity.IsAuthenticated)
    {
        <!-- Global JavaScript for authenticated users -->
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                // Initialize notification badges
                if (typeof initializeNotificationBadges === 'function') {
                    initializeNotificationBadges();
                }
            });
        </script>
    }
</body>
</html>