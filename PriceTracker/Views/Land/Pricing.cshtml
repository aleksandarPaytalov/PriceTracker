@{
    ViewData["Title"] = "Pricing - 100% Free!";
    ViewData["Description"] = "PriceTracker is completely free! Discover all our features at no cost and support us with a coffee if you love what we do.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/landingPage/pricing.css" asp-append-version="true" />
}

<!-- Quick Navigation (Optional - only shows on larger screens) -->
<nav class="quick-nav d-none d-lg-block">
    <div class="container">
        <div class="quick-nav-items">
            <a href="#hero" class="quick-nav-link active">
                <i class="fas fa-home"></i>
                <span>Overview</span>
            </a>
            <a href="#features" class="quick-nav-link">
                <i class="fas fa-star"></i>
                <span>Features</span>
            </a>
            <a href="#support" class="quick-nav-link">
                <i class="fas fa-coffee"></i>
                <span>Support Us</span>
            </a>
            <a href="#stats" class="quick-nav-link">
                <i class="fas fa-chart-bar"></i>
                <span>Stats</span>
            </a>
        </div>
    </div>
</nav>

<!-- Hero Section -->
<section id="hero" class="pricing-hero">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <div class="hero-content">
                    <h1 class="hero-title">
                        <i class="fas fa-gift text-primary me-3"></i>
                        Everything is <span class="text-success">FREE!</span>
                    </h1>
                    <p class="hero-subtitle">
                        No hidden fees, no premium plans, no credit card required.
                        Just pure price tracking and budget management joy! 🎉
                    </p>
                    <div class="hero-badges">
                        <span class="badge free-badge">
                            <i class="fas fa-heart me-1"></i>
                            Made with Love
                        </span>
                        <span class="badge free-badge">
                            <i class="fas fa-code me-1"></i>
                            Open Source
                        </span>
                        <span class="badge free-badge">
                            <i class="fas fa-shield-alt me-1"></i>
                            Privacy First
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Decorative Elements -->
    <div class="hero-decoration">
        <div class="floating-icon floating-icon-1">💰</div>
        <div class="floating-icon floating-icon-2">📊</div>
        <div class="floating-icon floating-icon-3">🛒</div>
        <div class="floating-icon floating-icon-4">✅</div>
    </div>
</section>

<!-- Features Showcase Section -->
<section id="features" class="features-showcase">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center mb-5">
                <h2 class="section-title">
                    <i class="fas fa-star text-warning me-2"></i>
                    What You Get For FREE
                </h2>
                <p class="section-subtitle">All features, unlimited usage, forever!</p>
            </div>
        </div>

        <div class="row g-4">
            <!-- Price Tracking Features -->
            <div class="col-lg-4 col-md-6">
                <div class="feature-card price-tracking-card">
                    <div class="feature-icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <h3 class="feature-title">Price Tracking</h3>
                    <ul class="feature-list">
                        <li><i class="fas fa-check text-success me-2"></i>Unlimited price history</li>
                        <li><i class="fas fa-check text-success me-2"></i>Store comparisons</li>
                        <li><i class="fas fa-check text-success me-2"></i>Price trend charts</li>
                        <li><i class="fas fa-check text-success me-2"></i>Best deal recommendations</li>
                    </ul>
                </div>
            </div>

            <!-- Budget Management Features -->
            <div class="col-lg-4 col-md-6">
                <div class="feature-card budget-card">
                    <div class="feature-icon">
                        <i class="fas fa-wallet"></i>
                    </div>
                    <h3 class="feature-title">Budget Management</h3>
                    <ul class="feature-list">
                        <li><i class="fas fa-check text-success me-2"></i>Monthly budgets</li>
                        <li><i class="fas fa-check text-success me-2"></i>Expense tracking</li>
                        <li><i class="fas fa-check text-success me-2"></i>Spending analytics</li>
                        <li><i class="fas fa-check text-success me-2"></i>Overspending alerts</li>
                    </ul>
                </div>
            </div>

            <!-- Task Management Features -->
            <div class="col-lg-4 col-md-6">
                <div class="feature-card task-card">
                    <div class="feature-icon">
                        <i class="fas fa-tasks"></i>
                    </div>
                    <h3 class="feature-title">Task Management</h3>
                    <ul class="feature-list">
                        <li><i class="fas fa-check text-success me-2"></i>Personal to-do lists</li>
                        <li><i class="fas fa-check text-success me-2"></i>Priority management</li>
                        <li><i class="fas fa-check text-success me-2"></i>Due date reminders</li>
                        <li><i class="fas fa-check text-success me-2"></i>Progress tracking</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Support Us Section -->
<section id="support" class="support-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="support-card">
                    <div class="support-header text-center">
                        <div class="coffee-icon">☕</div>
                        <h2 class="support-title">Love PriceTracker? Buy Us a Coffee!</h2>
                        <p class="support-subtitle">
                            While our app is completely free, your support helps us keep the servers running
                            and motivates us to add even more awesome features!
                        </p>
                    </div>

                    <div class="row justify-content-center mt-4">
                        <div class="col-12 col-sm-10 col-md-9 col-lg-8 col-xl-7 col-xxl-6">
                            <div class="payment-option-single">
                                <h4 class="payment-title text-center">
                                    <i class="fab fa-cc-visa me-2 text-primary"></i>
                                    Send us a coffee via Revolut
                                </h4>
                                <p class="payment-description text-center">Quick and easy way to support our project!</p>
                                <div class="payment-details">
                                    <div class="detail-item-single">
                                        <span class="detail-label">Revolut Link:</span>
                                        <div class="detail-value-container">
                                            <span class="detail-value" id="revolutLink">revolut.me/apaytalov89</span>
                                            <a href="https://revolut.me/apaytalov89"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="btn btn-success btn-sm donate-btn"
                                               title="Donate via Revolut">
                                                <i class="fas fa-heart"></i>
                                                <span class="donate-text">Donate</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Suggested Amounts -->
                    <div class="suggested-amounts mt-4">
                        <h5 class="text-center mb-3">
                            <i class="fas fa-coffee me-2 text-warning"></i>
                            Suggested Coffee Sizes
                        </h5>
                        <div class="amount-buttons">
                            <button class="btn btn-outline-warning coffee-amount" data-amount="1">
                                ☕ €1 <small>Espresso</small>
                            </button>
                            <button class="btn btn-outline-warning coffee-amount" data-amount="2">
                                ☕ €2 <small>Cappuccino</small>
                            </button>
                            <button class="btn btn-outline-warning coffee-amount" data-amount="5">
                                ☕ €5 <small>Premium Blend</small>
                            </button>
                            <button class="btn btn-outline-warning coffee-amount" data-amount="custom">
                                ☕ Custom <small>Your Choice</small>
                            </button>
                        </div>
                    </div>

                    <!-- Thank You Message -->
                    <div class="text-center mt-4">
                        <p class="thank-you-text">
                            <i class="fas fa-heart text-danger me-1"></i>
                            Every coffee helps us improve PriceTracker for everyone!
                            <i class="fas fa-heart text-danger ms-1"></i>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Fun Stats Section -->
<section id="stats" class="fun-stats">
    <div class="container">
        <div class="row text-center">
            <div class="col-12 mb-4">
                <h2 class="section-title">
                    <i class="fas fa-rocket me-2 text-primary"></i>
                    Fun Stats About PriceTracker
                </h2>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="stat-card">
                    <div class="stat-icon">💰</div>
                    <h3 class="stat-number">€0</h3>
                    <p class="stat-label">Cost to Use</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="stat-card">
                    <div class="stat-icon">⏰</div>
                    <h3 class="stat-number">∞</h3>
                    <p class="stat-label">Hours of Usage</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="stat-card">
                    <div class="stat-icon">📊</div>
                    <h3 class="stat-number">100%</h3>
                    <p class="stat-label">Free Features</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action Section -->
<section class="cta-section">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <div class="cta-content">
                    <h2 class="cta-title">Ready to Start Tracking?</h2>
                    <p class="cta-subtitle">
                        Join thousands of users who are already saving money with PriceTracker!
                    </p>
                    <div class="cta-buttons">
                        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-success btn-lg me-3">
                            <i class="fas fa-user-plus me-2"></i>
                            Get Started Free
                        </a>
                        <a href="@Url.Action("Index", "Land")"
                           class="btn btn-outline-primary btn-lg">
                            <i class="fas fa-info-circle me-2"></i>
                            Learn More
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/landingPage/pricing.js" asp-append-version="true"></script>
}