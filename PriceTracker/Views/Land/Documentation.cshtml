@{
    ViewData["Title"] = "Documentation - PriceTracker";
    ViewData["Description"] = "Complete guide to using PriceTracker for price monitoring, budget management, and task organization.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/landingPage/documentation.css" />
}

@section Scripts {
    <script src="~/js/landingPage/documentation.js"></script>
}

<div class="container mx-auto px-4 py-8">
    <!-- Header Section -->
    <div class="text-center mb-6 md:mb-8">
        <div class="flex items-center justify-center mb-3 md:mb-4">
            <i class="fas fa-tags text-blue-600 text-2xl md:text-3xl mr-2 md:mr-3"></i>
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900">PriceTracker</h1>
        </div>
        <h2 class="text-xl md:text-2xl text-gray-600 mb-3 md:mb-4">Documentation</h2>
        <p class="text-base md:text-lg text-gray-500 max-w-2xl mx-auto px-4">
            Everything you need to know about tracking prices, managing budgets, and staying organized with PriceTracker.
        </p>

        <!-- Back to Home Navigation -->
        <div class="mt-4 md:mt-6">
            <a href="@Url.Action("Index", "Land")"
               class="btn-primary inline-flex items-center px-4 py-3 md:py-2 text-white rounded-lg transition-colors w-full sm:w-auto justify-center">
                <i class="fas fa-arrow-left mr-2"></i>
                Back to Home
            </a>
        </div>
    </div>

    <!-- Main Content Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 lg:gap-8">

        <!-- Table of Contents - Fixed on Desktop -->
        <div class="lg:col-span-1 order-1 lg:order-1">
            <div class="lg:sticky lg:top-8">
                <nav class="no-print bg-gray-50 rounded-lg p-4 lg:p-6 mb-6 lg:mb-0">
                    <h3 class="font-semibold text-gray-900 mb-3 lg:mb-4">Contents</h3>
                    <ul class="space-y-1 lg:space-y-2 text-sm">
                        <li><a href="#getting-started" class="toc-link text-blue-600 hover:text-blue-800 block py-2 lg:py-1 px-2 rounded">Getting Started</a></li>
                        <li><a href="#core-features" class="toc-link text-blue-600 hover:text-blue-800 block py-2 lg:py-1 px-2 rounded">Core Features</a></li>
                        <li><a href="#user-guide" class="toc-link text-blue-600 hover:text-blue-800 block py-2 lg:py-1 px-2 rounded">User Guide</a></li>
                        <li><a href="#faq-redirect" class="toc-link text-blue-600 hover:text-blue-800 block py-2 lg:py-1 px-2 rounded">FAQ</a></li>
                        <li><a href="#support" class="toc-link text-blue-600 hover:text-blue-800 block py-2 lg:py-1 px-2 rounded">Support</a></li>
                    </ul>
                </nav>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="lg:col-span-3 order-2 lg:order-2">
            <article class="prose prose-sm sm:prose lg:prose-lg max-w-none">

                <!-- Getting Started Section -->
                <section id="getting-started" class="mb-8 lg:mb-12">
                    <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-4 lg:mb-6">Getting Started</h2>
                    <p class="text-gray-600 mb-4 lg:mb-6">
                        Welcome to PriceTracker! Get up and running in just a few simple steps.
                    </p>

                    <div class="bg-blue-50 border-l-4 border-blue-500 p-4 lg:p-6 mb-4 lg:mb-6">
                        <h4 class="font-semibold text-blue-900 mb-2 lg:mb-3">Quick Setup Guide</h4>
                        <ol class="list-decimal list-inside space-y-1 lg:space-y-2 text-blue-800 text-sm lg:text-base">
                            <li>Create your account or sign in with Google</li>
                            <li>Set up your first monthly budget</li>
                            <li>Add your favorite stores and products</li>
                            <li>Start tracking prices and expenses</li>
                        </ol>
                    </div>
                </section>

                <!-- Core Features Section -->
                <section id="core-features" class="mb-8 lg:mb-12">
                    <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-4 lg:mb-6">Core Features</h2>
                    <p class="text-gray-600 mb-4 lg:mb-6">
                        PriceTracker offers three main areas to help you save money and stay organized.
                    </p>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-6 mb-4 lg:mb-6">
                        <div class="feature-card bg-white rounded-lg p-4 lg:p-6">
                            <div class="feature-icon text-green-600 text-xl lg:text-2xl mb-2 lg:mb-3">
                                <i class="fas fa-chart-line"></i>
                            </div>
                            <h4 class="font-semibold text-gray-900 mb-1 lg:mb-2 text-base lg:text-lg">Price Tracking</h4>
                            <p class="text-gray-600 text-xs lg:text-sm">Monitor product prices across different stores and get notified of the best deals.</p>
                        </div>

                        <div class="feature-card bg-white rounded-lg p-4 lg:p-6">
                            <div class="feature-icon text-blue-600 text-xl lg:text-2xl mb-2 lg:mb-3">
                                <i class="fas fa-wallet"></i>
                            </div>
                            <h4 class="font-semibold text-gray-900 mb-1 lg:mb-2 text-base lg:text-lg">Budget Management</h4>
                            <p class="text-gray-600 text-xs lg:text-sm">Set monthly budgets, track expenses, and get alerts when you're close to your limits.</p>
                        </div>

                        <div class="feature-card bg-white rounded-lg p-4 lg:p-6 md:col-span-2 lg:col-span-1">
                            <div class="feature-icon text-purple-600 text-xl lg:text-2xl mb-2 lg:mb-3">
                                <i class="fas fa-tasks"></i>
                            </div>
                            <h4 class="font-semibold text-gray-900 mb-1 lg:mb-2 text-base lg:text-lg">Task Management</h4>
                            <p class="text-gray-600 text-xs lg:text-sm">Organize your shopping lists and to-do items with priority levels and due dates.</p>
                        </div>
                    </div>
                </section>

                <!-- User Guide Section -->
                <section id="user-guide" class="mb-8 lg:mb-12">
                    <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-4 lg:mb-6">User Guide</h2>
                    <p class="text-gray-600 mb-4 lg:mb-6">
                        Step-by-step instructions for the most common tasks in PriceTracker.
                    </p>

                    <div class="space-y-6 lg:space-y-8">
                        <div>
                            <h4 class="font-semibold text-gray-900 mb-2 lg:mb-3 text-base lg:text-lg">How to Track a Product Price</h4>
                            <ul class="list-disc list-inside space-y-1 text-gray-600 ml-2 lg:ml-4 text-sm lg:text-base">
                                <li>Navigate to the Price Tracking section</li>
                                <li>Click "Add New Product" and enter product details</li>
                                <li>Add the product to your preferred stores with current prices</li>
                                <li>Set up price alerts for when prices drop</li>
                            </ul>
                        </div>

                        <div>
                            <h4 class="font-semibold text-gray-900 mb-2 lg:mb-3 text-base lg:text-lg">How to Set Up a Monthly Budget</h4>
                            <ul class="list-disc list-inside space-y-1 text-gray-600 ml-2 lg:ml-4 text-sm lg:text-base">
                                <li>Go to Budget Management and click "Create Budget"</li>
                                <li>Set your total monthly spending limit</li>
                                <li>Allocate amounts to different categories (groceries, entertainment, etc.)</li>
                                <li>Enable overspending alerts at your preferred threshold</li>
                            </ul>
                        </div>

                        <div>
                            <h4 class="font-semibold text-gray-900 mb-2 lg:mb-3 text-base lg:text-lg">How to Create and Manage Tasks</h4>
                            <ul class="list-disc list-inside space-y-1 text-gray-600 ml-2 lg:ml-4 text-sm lg:text-base">
                                <li>Access the Task Management section from the main menu</li>
                                <li>Click "New Task" and enter task details</li>
                                <li>Set priority level (High, Medium, Low) and due date</li>
                                <li>Use filters to view tasks by status or priority</li>
                            </ul>
                        </div>
                    </div>
                </section>

                <!-- FAQ Redirect Section -->
                <section id="faq-redirect" class="mb-8 lg:mb-12">
                    <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-4 lg:mb-6">Frequently Asked Questions</h2>

                    <div class="bg-blue-50 from-gray-50 to-gray-100 rounded-xl p-8 lg:p-12 text-center border border-gray-200">
                        <div class="max-w-2xl mx-auto">
                            <!-- Icon -->
                            <div class="mb-6">
                                <i class="fas fa-question-circle text-5xl text-teal-600"></i>
                            </div>

                            <!-- Heading -->
                            <h3 class="text-xl lg:text-2xl font-semibold text-gray-900 mb-4">
                                Have a question?
                            </h3>

                            <!-- Description -->
                            <p class="text-gray-600 mb-8 text-base lg:text-lg leading-relaxed">
                                Check our comprehensive FAQ page with the most commonly asked questions and detailed answers about PriceTracker features, pricing, and support.
                            </p>

                            <!-- Button Container -->
                            <div class="flex justify-center">
                                <a href="@Url.Action("FAQ", "Land")"
                                   class="btn-faq">
                                    <i class="fas fa-external-link-alt mr-2"></i>
                                    Visit FAQ Page
                                </a>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Support Section -->
                <section id="support" class="mb-8 lg:mb-12">
                    <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-4 lg:mb-6">Support</h2>
                    <p class="text-gray-600 mb-4 lg:mb-6">
                        Need help? We're here to assist you with any questions or issues.
                    </p>

                    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 lg:p-6">
                        <h4 class="font-semibold text-blue-900 mb-3 lg:mb-4 text-base lg:text-lg">Get in Touch</h4>
                        <div class="space-y-2 lg:space-y-3">
                            <div class="flex items-center text-blue-800 text-sm lg:text-base">
                                <i class="fas fa-envelope mr-2 lg:mr-3"></i>
                                <span>Email: support@pricetracker.com</span>
                            </div>
                            <div class="flex items-center text-blue-800 text-sm lg:text-base">
                                <i class="fas fa-clock mr-2 lg:mr-3"></i>
                                <span>Response time: Within 24 hours</span>
                            </div>
                        </div>

                        <div class="mt-4 lg:mt-6">
                            <a href="@Url.Action("Contact", "Land")"
                               class="btn-primary inline-flex items-center px-4 py-3 lg:py-2 text-white rounded-lg transition-colors w-full sm:w-auto justify-center">
                                <i class="fas fa-paper-plane mr-2"></i>
                                Contact Support
                            </a>
                        </div>
                    </div>
                </section>

            </article>
        </div>
    </div>

    <!-- Back to Top Button (will be controlled by JS) -->
    <button id="backToTop"
            class="no-print fixed bottom-8 right-8 bg-blue-600 text-white p-3 rounded-full shadow-lg hover:bg-blue-700 transition-all opacity-0 pointer-events-none">
        <i class="fas fa-arrow-up"></i>
    </button>
</div>